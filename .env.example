# PostHog (analytics) — optional
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Payload
PAYLOAD_SECRET=
# MongoDB Atlas connection string — new database on the Soter cluster.
DATABASE_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/parpali

# Hetzner Object Storage (S3-compatible) — optional in dev; required for Media uploads in prod.
# When all five are set, Payload routes Media uploads to this bucket. When any are missing,
# Payload falls back to local /media/ storage.
S3_BUCKET=parpali
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=hel1

# Resend (transactional email for reservation confirmations) — optional in dev.
# Without RESEND_API_KEY, email sends are no-op'd and logged to console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Parpali <noreply@parpali.de>

# Public site URL — used for absolute URLs in OG tags, emails, sitemaps.
NEXT_PUBLIC_SITE_URL=https://parpali.de

# Reminder cron — secret required to call GET /api/cron/reminders
# (?secret=… or Bearer header). Leave empty to disable the check (dev only).
CRON_SECRET=
